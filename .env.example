# Copy to .env (`cp .env.example .env`) or run `make env`, which fills every
# secret below with a random value. The placeholders work for a local run but
# are public: never use them outside this machine.

APP_ENV=dev
LOG_LEVEL=INFO

# Postgres password of the scheduler database (used only by postgres and the API).
POSTGRES_PASSWORD=local-only-placeholder-postgres-password
# X-API-Key of the scheduler API (at least 32 characters).
SCHEDULER_API_KEY=local-only-placeholder-scheduler-api-key-0000
# Bearer token shared by the agent and the MCP servers (at least 32 characters).
MCP_AUTH_TOKEN=local-only-placeholder-mcp-auth-token-000000
# HMAC key the OCR server uses to pseudonymize personal data (at least 32 characters).
PII_HMAC_SECRET=local-only-placeholder-pii-hmac-secret-00000

# Gemini API key (https://aistudio.google.com/apikey); only the agent receives it.
GOOGLE_API_KEY=
# gemini, or fake (test fixture; requires APP_ENV=test).
AGENT_LLM_BACKEND=gemini
