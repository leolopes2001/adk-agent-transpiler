# Configuration read by Docker Compose. To run the project:
#   1. copy this file to .env   (macOS/Linux: cp .env.example .env
#                                Windows PowerShell: Copy-Item .env.example .env)
#   2. fill in GOOGLE_API_KEY below.
#
# The secrets below are valid values FOR LOCAL DEVELOPMENT ONLY: they are public,
# so never use them on a shared or exposed machine. To replace them with random
# values (optional), generate one per secret with
#   docker run --rm python:3.12.16-slim-trixie python -c "import secrets; print(secrets.token_urlsafe(32))"
# and keep to letters, digits, "-" and "_" (POSTGRES_PASSWORD goes inside a URL).
# Postgres keeps the password it was created with: after changing
# POSTGRES_PASSWORD, recreate the database with `docker compose down -v`.

APP_ENV=dev
LOG_LEVEL=INFO

# Postgres password of the scheduler database (used only by postgres and the API).
POSTGRES_PASSWORD=local-dev-only-postgres-password-000000
# X-API-Key of the scheduler API (at least 32 characters).
SCHEDULER_API_KEY=local-dev-only-scheduler-api-key-000000
# Bearer token shared by the agent and the MCP servers (at least 32 characters).
MCP_AUTH_TOKEN=local-dev-only-mcp-auth-token-0000000000
# HMAC key the OCR server uses to pseudonymize personal data (at least 32 characters).
PII_HMAC_SECRET=local-dev-only-pii-hmac-secret-000000000

# Gemini API key (https://aistudio.google.com/apikey); only the agent receives it.
GOOGLE_API_KEY=
# gemini, or fake (test fixture; requires APP_ENV=test).
AGENT_LLM_BACKEND=gemini
