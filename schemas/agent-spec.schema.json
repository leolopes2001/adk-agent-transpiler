{
  "$defs": {
    "AbortNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "abort",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "AbortNode",
      "type": "object"
    },
    "AgentInfo": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "version"
      ],
      "title": "AgentInfo",
      "type": "object"
    },
    "ConfidenceGateNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "confidence_gate",
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ConfidenceGateParams"
        }
      },
      "required": [
        "id",
        "kind",
        "params"
      ],
      "title": "ConfidenceGateNode",
      "type": "object"
    },
    "ConfidenceGateParams": {
      "additionalProperties": false,
      "properties": {
        "accept_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Accept Threshold",
          "type": "number"
        },
        "min_margin": {
          "maximum": 0.5,
          "minimum": 0,
          "title": "Min Margin",
          "type": "number"
        },
        "review_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Review Threshold",
          "type": "number"
        }
      },
      "required": [
        "accept_threshold",
        "review_threshold",
        "min_margin"
      ],
      "title": "ConfidenceGateParams",
      "type": "object"
    },
    "EdgeSpec": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "pattern": "^(START|[a-z][a-z0-9_]{0,62})$",
          "title": "From",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "to": {
          "pattern": "^(START|[a-z][a-z0-9_]{0,62})$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "EdgeSpec",
      "type": "object"
    },
    "GraphSpec": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/EdgeSpec"
          },
          "maxItems": 1000,
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "discriminator": {
              "mapping": {
                "abort": "#/$defs/AbortNode",
                "confidence_gate": "#/$defs/ConfidenceGateNode",
                "human_review": "#/$defs/HumanReviewNode",
                "join": "#/$defs/JoinNodeSpec",
                "lexical_extract": "#/$defs/LexicalExtractNode",
                "llm_extract": "#/$defs/LlmExtractNode",
                "ocr_extract": "#/$defs/OcrExtractNode",
                "present": "#/$defs/PresentNode",
                "rag_resolve": "#/$defs/RagResolveNode",
                "reconcile": "#/$defs/ReconcileNode",
                "schedule": "#/$defs/ScheduleNode",
                "subworkflow": "#/$defs/SubworkflowNode",
                "untrusted_text_guard": "#/$defs/UntrustedTextGuardNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/OcrExtractNode"
              },
              {
                "$ref": "#/$defs/UntrustedTextGuardNode"
              },
              {
                "$ref": "#/$defs/LlmExtractNode"
              },
              {
                "$ref": "#/$defs/LexicalExtractNode"
              },
              {
                "$ref": "#/$defs/JoinNodeSpec"
              },
              {
                "$ref": "#/$defs/ReconcileNode"
              },
              {
                "$ref": "#/$defs/RagResolveNode"
              },
              {
                "$ref": "#/$defs/ConfidenceGateNode"
              },
              {
                "$ref": "#/$defs/HumanReviewNode"
              },
              {
                "$ref": "#/$defs/ScheduleNode"
              },
              {
                "$ref": "#/$defs/PresentNode"
              },
              {
                "$ref": "#/$defs/AbortNode"
              },
              {
                "$ref": "#/$defs/SubworkflowNode"
              }
            ]
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "GraphSpec",
      "type": "object"
    },
    "HttpServiceSpec": {
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Api Key Env",
          "type": "string"
        },
        "base_url_env": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Base Url Env",
          "type": "string"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "base_url_env",
        "api_key_env",
        "timeout_s"
      ],
      "title": "HttpServiceSpec",
      "type": "object"
    },
    "HumanReviewNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "human_review",
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HumanReviewParams"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "HumanReviewNode",
      "type": "object"
    },
    "HumanReviewParams": {
      "additionalProperties": false,
      "properties": {
        "max_candidates": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "on_non_interactive": {
          "const": "reject",
          "default": "reject",
          "title": "On Non Interactive",
          "type": "string"
        }
      },
      "title": "HumanReviewParams",
      "type": "object"
    },
    "JoinNodeSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "join",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "JoinNodeSpec",
      "type": "object"
    },
    "LexicalExtractNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
