    "ModelSpec": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9.\\-]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "const": "gemini",
          "title": "Provider",
          "type": "string"
        },
        "temperature": {
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "name",
        "temperature",
        "max_output_tokens"
