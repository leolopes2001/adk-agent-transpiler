        "kind": {
          "const": "lexical_extract",
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/LexicalExtractParams"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "server": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Server",
          "type": "string"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 300,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        },
        "tool": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "server",
        "tool"
      ],
      "title": "LexicalExtractNode",
      "type": "object"
    },
    "LexicalExtractParams": {
      "additionalProperties": false,
      "properties": {
        "max_lines": {
          "default": 60,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        },
        "min_score": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Score",
          "type": "number"
        }
      },
      "title": "LexicalExtractParams",
      "type": "object"
    },
    "LlmAgentSpec": {
      "additionalProperties": false,
      "properties": {
        "input_trust": {
          "default": "untrusted",
          "enum": [
            "untrusted",
            "trusted"
          ],
          "title": "Input Trust",
          "type": "string"
        },
        "instruction_file": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\x00\\\\]+$",
          "title": "Instruction File",
          "type": "string"
        },
        "model": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Model",
          "type": "string"
        },
        "output_schema": {
          "const": "ExtractedExams",
          "title": "Output Schema",
          "type": "string"
        },
        "tools": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "model",
        "instruction_file",
        "output_schema"
      ],
      "title": "LlmAgentSpec",
      "type": "object"
    },
    "LlmExtractNode": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
