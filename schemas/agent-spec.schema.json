        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 300,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "required": [
        "id",
        "kind",
        "agent"
      ],
      "title": "LlmExtractNode",
      "type": "object"
    },
    "McpServerSpec": {
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Allowed Tools",
          "type": "array"
        },
        "auth_token_env": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Auth Token Env",
          "type": "string"
        },
        "connect_timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Connect Timeout S",
          "type": "number"
        },
        "read_timeout_s": {
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Read Timeout S",
          "type": "number"
        },
        "transport": {
          "const": "sse",
          "title": "Transport",
          "type": "string"
        },
        "url_env": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Url Env",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "url_env",
        "auth_token_env",
        "allowed_tools",
        "connect_timeout_s",
        "read_timeout_s"
      ],
      "title": "McpServerSpec",
      "type": "object"
