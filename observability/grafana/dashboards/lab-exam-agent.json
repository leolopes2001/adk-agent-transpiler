{
  "uid": "lab-exam-agent",
  "title": "Lab Exam Agent",
  "description": "Uma execução do agente de ponta a ponta: logs dos quatro serviços e o trace.",
  "tags": [
    "lab-exam-agent"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "run_id",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "description": "Execuções do agente no período (cada execução é uma instância do serviço agent).",
        "query": {
          "qryType": 1,
          "label": "service_instance_id",
          "stream": "{service_name=\"agent\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({service_name=\"agent\"},service_instance_id)",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Execução selecionada:** escolha o `run_id` no topo ou clique numa linha de *Últimas execuções*. Nos logs, abra uma linha e clique em **Abrir o trace** para ir ao trace dela; no trace, o ícone de logs de cada span volta aos logs. Nada aqui contém dados pessoais: só ids, contagens, códigos de exame, status e tempos."
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "table",
      "title": "Últimas execuções",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 15,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Um registro run_finished por execução do agente (mais recentes primeiro). Clique no run_id para selecioná-la.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "maxLines": 100,
          "expr": "{service_name=\"agent\"} | event=\"run_finished\""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": true
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "run_id",
                "outcome",
                "exit_code",
                "duration_ms"
              ]
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "exit_code",
                "destinationType": "number"
              },
              {
                "targetField": "duration_ms",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "run_id": 1,
              "outcome": 2,
              "exit_code": 3,
              "duration_ms": 4
            },
            "renameByName": {
              "Time": "Fim",
              "outcome": "Resultado",
              "exit_code": "Exit code",
              "duration_ms": "Duração"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Selecionar esta execução",
                    "url": "/d/lab-exam-agent/lab-exam-agent?var-run_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 320
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duração"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exit code"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Erros por serviço (período)",
      "gridPos": {
        "x": 15,
        "y": 3,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Registros de nível error ou critical de cada serviço no período do painel.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "legendFormat": "{{service_name}}",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"agent|ocr-mcp|rag-mcp|scheduler-api\"} | level=~\"error|critical\" [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Trace da execução",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 9,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "O trace da execução selecionada no Tempo. Clique no Trace ID para abrir a linha do tempo com todos os spans.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 5,
          "query": "{span.lab.run_id=\"$run_id\" && name=\"lab-agent run\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Duração por nó",
      "gridPos": {
        "x": 9,
        "y": 11,
        "w": 15,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Spans invoke_node e invoke_agent (o nó do LLM) da execução selecionada.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 5,
          "spss": 100,
          "query": "{span.lab.run_id=\"$run_id\" && name=\"lab-agent run\"} >> {name=~\"invoke_(node|agent) .*\"}"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "time"
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "name",
                "duration"
              ]
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "duration",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Nó",
              "duration": "Duração"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Nó",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "xTickLabelMaxLength": 40,
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs da execução (todos os serviços)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Agente (run_id) e servidores (request_id = run_id), em ordem. São as mesmas linhas JSON do stderr, já redigidas.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{service_name=~\"agent|ocr-mcp|rag-mcp|scheduler-api\"} | run_id=\"$run_id\" or request_id=\"$run_id\" | line_format \"[{{.service_name}}] {{__line__}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      }
    }
  ]
}
