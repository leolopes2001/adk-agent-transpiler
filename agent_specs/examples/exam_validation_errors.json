{
  "$schema": "../agent_spec.schema.json",
  "spec_version": "1.0",
  "agent": {
    "name": "exam_validation_errors",
    "description": "Exemplo intencionalmente inválido para demonstrar quatro mensagens de validação; não deve ser executado.",
    "version": "1.0.0"
  },
  "mcp_servers": {
    "ocr": {
      "transport": "sse",
      "url_env": "OCR_MCP_URL",
      "auth_token_env": "MCP_AUTH_TOKEN",
      "allowed_tools": [
        "extract_text"
      ],
      "connect_timeout_s": 5,
      "read_timeout_s": 40
    },
    "rag": {
      "transport": "sse",
      "url_env": "RAG_MCP_URL",
      "auth_token_env": "MCP_AUTH_TOKEN",
      "allowed_tools": [
        "batch_search"
      ],
      "connect_timeout_s": 5,
      "read_timeout_s": 15
    }
  },
  "workflow": {
    "nodes": [
      {
        "id": "ocr",
        "kind": "ocr_extract",
        "server": "ocr",
        "tool": "extract_text",
        "params": {
          "min_mean_confidence": 0.55,
          "max_image_bytes": 8388608
        },
        "retry": {
          "max_attempts": 3,
          "initial_delay_s": 0.5,
          "max_delay_s": 4
        },
        "timeout_s": 1
      },
      {
        "id": "guard",
        "kind": "untrusted_text_guard",
        "params": {
          "max_chars": 8000,
          "block_at": "high"
        }
      },
      {
        "id": "lexical_extract",
        "kind": "lexical_extract",
        "server": "rag_missing",
        "tool": "batch_search",
        "params": {
          "min_score": 0.8,
          "max_lines": 60
        },
        "timeout_s": 20
      },
      {
        "id": "resolve",
        "kind": "rag_resolve",
        "server": "rag",
        "tool": "batch_search",
        "params": {
          "top_k": 5
        },
        "retry": {
          "max_attempts": 3,
          "initial_delay_s": 0.5,
          "max_delay_s": 4
        },
        "timeout_s": 20
      },
      {
        "id": "gate",
        "kind": "confidence_gate",
        "params": {
          "accept_threshold": 0.85,
          "review_threshold": 0.85,
          "min_margin": 0.05
        }
      },
      {
        "id": "present",
        "kind": "present",
        "params": {
          "format": "json"
        }
      },
      {
        "id": "abort",
        "kind": "abort"
      }
    ],
    "edges": [
      {
        "from": "START",
        "to": "ocr"
      },
      {
        "from": "ocr",
        "to": "guard",
        "route": "ok"
      },
      {
        "from": "ocr",
        "to": "abort",
        "route": "low_quality"
      },
      {
        "from": "guard",
        "to": "lexical_extract",
        "route": "clean"
      },
      {
        "from": "lexical_extract",
        "to": "resolve"
      },
      {
        "from": "resolve",
        "to": "gate"
      },
      {
        "from": "gate",
        "to": "present",
        "route": "accepted"
      },
      {
        "from": "gate",
        "to": "present",
        "route": "review"
      },
      {
        "from": "gate",
        "to": "abort",
        "route": "empty"
      }
    ]
  },
  "policies": {
    "pii": {
      "fail_closed": false
    },
    "defaults": {
      "retry": {
        "max_attempts": 1,
        "initial_delay_s": 0.5,
        "max_delay_s": 2
      },
      "timeout_s": 30
    }
  }
}
