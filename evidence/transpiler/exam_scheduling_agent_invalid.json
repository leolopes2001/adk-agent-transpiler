{
  "spec_version": "1.0",
  "agent": {
    "name": "exam_scheduling_agent",
    "description": "Agenda exames a partir da imagem de um pedido médico: OCR, resolução no catálogo e solicitação de agendamento.",
    "version": "1.0.0"
  },
  "models": {
    "extractor": {
      "provider": "gemini",
      "name": "gemini-flash-latest",
      "temperature": 0.0,
      "max_output_tokens": 2048
    }
  },
  "mcp_servers": {
    "ocr": {
      "transport": "sse",
      "url_env": "OCR_MCP_URL",
      "auth_token_env": "MCP_AUTH_TOKEN",
      "allowed_tools": [
        "extract_text"
      ],
      "connect_timeout_s": 5,
      "read_timeout_s": 40
    },
    "rag": {
      "transport": "sse",
      "url_env": "RAG_MCP_URL",
      "auth_token_env": "MCP_AUTH_TOKEN",
      "allowed_tools": [
        "batch_search"
      ],
      "connect_timeout_s": 5,
      "read_timeout_s": 15
    }
  },
  "http_services": {
    "scheduler": {
      "base_url_env": "SCHEDULER_API_URL",
      "api_key_env": "SCHEDULER_API_KEY",
      "timeout_s": 10
    }
  },
  "llm_agents": {
    "exam_extractor": {
      "model": "extractor",
      "instruction_file": "instructions/exam_extractor.md",
      "output_schema": "ExtractedExams",
      "tools": [],
      "input_trust": "untrusted"
    }
  },
  "workflow": {
    "nodes": [
      {
        "id": "ocr",
        "kind": "ocr_extract",
        "server": "ocr",
        "tool": "read_file",
        "params": {
          "min_mean_confidence": 0.55,
          "max_image_bytes": 8388608
        },
        "retry": {
          "max_attempts": 3,
          "initial_delay_s": 0.5,
          "max_delay_s": 4
        },
        "timeout_s": 45
      },
      {
        "id": "guard",
        "kind": "untrusted_text_guard",
        "params": {
          "max_chars": 8000,
          "block_at": "high"
        }
      },
      {
        "id": "extraction",
        "kind": "subworkflow",
        "ref": "extraction"
      },
      {
        "id": "resolve",
        "kind": "rag_resolve",
        "server": "rag",
        "tool": "batch_search",
        "params": {
          "top_k": 5
        },
        "retry": {
          "max_attempts": 3,
          "initial_delay_s": 0.5,
          "max_delay_s": 4
        },
        "timeout_s": 20
      },
      {
        "id": "gate",
        "kind": "confidence_gate",
        "params": {
          "accept_threshold": 0.85,
          "review_threshold": 0.6,
          "min_margin": 0.05
        }
      },
      {
        "id": "review",
        "kind": "human_review",
        "params": {
          "on_non_interactive": "reject",
          "max_candidates": 3
        }
      },
      {
        "id": "schedule",
        "kind": "schedule",
        "service": "payments",
        "retry": {
          "max_attempts": 3,
          "initial_delay_s": 0.5,
          "max_delay_s": 4
        },
        "timeout_s": 15
      },
      {
        "id": "present",
        "kind": "present",
        "params": {
          "format": "table"
        }
      },
      {
        "id": "abort",
        "kind": "abort"
      }
    ],
    "edges": [
      {
        "from": "START",
        "to": "ocr"
      },
      {
        "from": "ocr",
        "to": "guard",
        "route": "ok"
      },
      {
        "from": "ocr",
        "to": "abort",
        "route": "low_quality"
      },
      {
        "from": "guard",
        "to": "extraction",
        "route": "clean"
      },
      {
        "from": "guard",
        "to": "abort",
        "route": "blocked"
      },
      {
        "from": "extraction",
        "to": "resolve"
      },
      {
        "from": "resolve",
        "to": "gate"
      },
      {
        "from": "gate",
        "to": "schedule",
        "route": "accepted"
      },
      {
        "from": "gate",
        "to": "review",
        "route": "review"
      },
      {
        "from": "gate",
        "to": "abort",
        "route": "empty"
      },
      {
        "from": "review",
        "to": "schedule",
        "route": "confirmed"
      },
      {
        "from": "review",
        "to": "present",
        "route": "rejected"
      },
      {
        "from": "schedule",
        "to": "present"
      },
      {
        "from": "guard",
        "to": "schedule",
        "route": "clean"
      }
    ]
  },
  "subworkflows": {
    "extraction": {
      "nodes": [
        {
          "id": "llm_extract",
          "kind": "llm_extract",
          "agent": "exam_extractor",
          "retry": {
            "max_attempts": 2,
            "initial_delay_s": 1,
            "max_delay_s": 4
          },
          "timeout_s": 30
        },
        {
          "id": "lexical_extract",
          "kind": "lexical_extract",
          "server": "rag",
          "tool": "batch_search",
          "params": {
            "min_score": 0.8,
            "max_lines": 60
          },
          "timeout_s": 20
        },
        {
          "id": "merge",
          "kind": "join"
        },
        {
          "id": "reconcile",
          "kind": "reconcile",
          "params": {
            "grounding_min_ratio": 90,
            "max_items": 30
          }
        }
      ],
      "edges": [
        {
          "from": "START",
          "to": "llm_extract"
        },
        {
          "from": "START",
          "to": "lexical_extract"
        },
        {
          "from": "llm_extract",
          "to": "merge"
        },
        {
          "from": "lexical_extract",
          "to": "merge"
        },
        {
          "from": "merge",
          "to": "reconcile"
        }
      ]
    }
  },
  "policies": {
    "pii": {
      "fail_closed": true
    },
    "defaults": {
      "retry": {
        "max_attempts": 1,
        "initial_delay_s": 0.5,
        "max_delay_s": 2
      },
      "timeout_s": 30
    }
  }
}
